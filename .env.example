# Environment variables — copy to .env and fill in values

# PostgreSQL Data Warehouse
DATABASE_URL=postgresql://scrap_user:scrap_pass@localhost:5432/scrap_dw
POSTGRES_USER=scrap_user
POSTGRES_PASSWORD=scrap_pass
POSTGRES_DB=scrap_dw

# MinIO Data Lake (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Kafka Streaming
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=news

# Airflow (overrides for local dev)
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
